+// Visual calibration against small top-aligned text in the game client; not native font metrics.
+// Keep anchors, clipping, line spacing, and measured sizes unchanged.
+fn preview_text_top_inset(kind: WidgetType, justify_v: TextJustify, scale: f32) -> f32 {
+    if kind == WidgetType::FontString && justify_v == TextJustify::Left {
+        2.0 * scale
+    } else {
+        0.0
+    }
+}
