+#[cfg(test)]
+mod preview_text_alignment_tests {
+    use super::*;
+
+    #[test]
+    fn preview_text_top_inset_scales_in_ui_units() {
+        for (scale, inset) in [(1.0, 2.0), (1.5, 3.0), (2.0, 4.0)] {
+            assert_eq!(preview_text_top_inset(WidgetType::FontString, TextJustify::Left, scale), inset);
+        }
+    }
+
+    #[test]
+    fn preview_text_top_inset_leaves_other_alignment_unchanged() {
+        for justify in [TextJustify::Center, TextJustify::Right] {
+            assert_eq!(preview_text_top_inset(WidgetType::FontString, justify, 1.5), 0.0);
+        }
+        assert_eq!(preview_text_top_inset(WidgetType::Button, TextJustify::Left, 1.5), 0.0);
+    }
